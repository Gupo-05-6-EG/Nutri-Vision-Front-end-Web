# ---------------------------------------------------------------------------
# Nutri Vision - Painel Web (React + Vite)
# Copie para `.env.local` e ajuste. Apenas variaveis com prefixo VITE_ chegam
# ao codigo do cliente - nunca coloque segredo aqui, o bundle e publico.
# ---------------------------------------------------------------------------

# URL base da API do back-end
VITE_API_URL=http://localhost:8000/api/v1

# Nome exibido na interface
VITE_APP_NAME="Nutri Vision"

# Ambiente (development | staging | production)
VITE_ENVIRONMENT=development
